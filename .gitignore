# Python
__pycache__/
*.py[cod]
.venv/
.ipynb_checkpoints/
.pytest_cache/
*.egg-info/

# Data: the workbook is redistributable under CC BY 4.0 and is committed so the
# repository is self-contained; the processed splits are regenerated by the
# pipeline and are therefore ignored.
/data/processed/*.csv
/data/raw/*.zip
/data/raw/*.sha256

# Regenerable per-model artefacts (the selected model is kept)
/models/*.joblib
!/models/best_model.joblib
/results/predictions/*.npy

# LaTeX build products
report/latex/*.aux
report/latex/*.log
report/latex/*.out
report/latex/*.toc
report/latex/*.lof
report/latex/*.lot
report/latex/*.fls
report/latex/*.fdb_latexmk
report/latex/*.synctex.gz
report/latex/chapters/*.aux
report/build/

# OS / editor
.DS_Store
.vscode/
.idea/
